{
  "$defs": {
    "ChargeDetails": {
      "additionalProperties": false,
      "properties": {
        "charge_item": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Charge Item"
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "payment_term": {
          "anyOf": [
            {
              "enum": [
                "PP",
                "CC"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Payment Term"
        },
        "charge_item_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Charge Item Raw"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "unit_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price"
        },
        "payment_term_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payment Term Raw"
        },
        "currency_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency Raw"
        }
      },
      "required": [
        "charge_item",
        "amount",
        "currency",
        "payment_term"
      ],
      "title": "ChargeDetails",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "not_checkable",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "actual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "status",
        "message"
      ],
      "title": "Check",
      "type": "object"
    },
    "DocumentInfo": {
      "additionalProperties": false,
      "properties": {
        "document_type": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Document Type"
        },
        "reference_no": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference No"
        },
        "document_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Document Date"
        },
        "document_date_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Date Raw"
        }
      },
      "required": [
        "document_type",
        "reference_no",
        "document_date"
      ],
      "title": "DocumentInfo",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "quote": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "locator",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExtractedCandidate": {
      "additionalProperties": false,
      "properties": {
        "source_line_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Line Id",
          "type": "string"
        },
        "document_info": {
          "$ref": "#/$defs/DocumentInfo"
        },
        "transaction_party": {
          "$ref": "#/$defs/TransactionParty"
        },
        "charge_details": {
          "$ref": "#/$defs/ChargeDetails"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "shipping_info": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Shipping Info",
          "type": "object"
        },
        "field_evidence": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Evidence"
            },
            "type": "array"
          },
          "title": "Field Evidence",
          "type": "object"
        },
        "related_fields": {
          "items": {
            "$ref": "#/$defs/RelatedField"
          },
          "title": "Related Fields",
          "type": "array"
        }
      },
      "required": [
        "source_line_id",
        "document_info",
        "transaction_party",
        "charge_details",
        "evidence",
        "source_id"
      ],
      "title": "ExtractedCandidate",
      "type": "object"
    },
    "FinancialAttributes": {
      "additionalProperties": false,
      "properties": {
        "accounting_entity": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accounting Entity"
        },
        "posting_type": {
          "anyOf": [
            {
              "enum": [
                "AR",
                "AP"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Posting Type"
        }
      },
      "required": [
        "accounting_entity",
        "posting_type"
      ],
      "title": "FinancialAttributes",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "blocks_automation": {
          "title": "Blocks Automation",
          "type": "boolean"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "blocks_automation",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "email_body",
            "email_header",
            "pdf_page",
            "image_region",
            "sheet_cells",
            "word_block",
            "existing_record"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "region": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "sheet": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "cells": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cells"
        },
        "block": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block"
        },
        "pointer": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointer"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Locator",
      "type": "object"
    },
    "NormalizedFile": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "parent_source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Source Id"
        },
        "status": {
          "enum": [
            "ready",
            "no_charge",
            "pending_review",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "line_ids": {
          "items": {
            "type": "string"
          },
          "title": "Line Ids",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "status"
      ],
      "title": "NormalizedFile",
      "type": "object"
    },
    "NormalizedLine": {
      "additionalProperties": false,
      "properties": {
        "source_line_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Line Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "original": {
          "$ref": "#/$defs/ExtractedCandidate"
        },
        "candidate": {
          "$ref": "#/$defs/ExtractedCandidate"
        },
        "financial_attributes": {
          "$ref": "#/$defs/FinancialAttributes"
        },
        "status": {
          "default": "pending_review",
          "enum": [
            "ready",
            "pending_review"
          ],
          "title": "Status",
          "type": "string"
        },
        "balance_effect": {
          "default": "unknown",
          "enum": [
            "increase",
            "decrease",
            "none",
            "unknown"
          ],
          "title": "Balance Effect",
          "type": "string"
        },
        "currency_minor_units": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency Minor Units"
        },
        "settlement_condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settlement Condition"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/RuleEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "source_line_id",
        "source_id",
        "original",
        "candidate",
        "financial_attributes"
      ],
      "title": "NormalizedLine",
      "type": "object"
    },
    "RelatedField": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "enum": [
            "/settlement/payer",
            "/settlement/payee",
            "/transaction_party/issuer",
            "/transaction_party/recipient",
            "/charge_details/currency"
          ],
          "title": "Path",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Value",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "applied",
            "suggested",
            "conflict"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "path",
        "value",
        "source_id",
        "status",
        "reason",
        "evidence"
      ],
      "title": "RelatedField",
      "type": "object"
    },
    "RuleEvent": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rule",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        },
        "old": {
          "title": "Old"
        },
        "new": {
          "title": "New"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "context_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Pointer"
        }
      },
      "required": [
        "rule",
        "path",
        "old",
        "new"
      ],
      "title": "RuleEvent",
      "type": "object"
    },
    "TransactionParty": {
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Issuer"
        },
        "recipient": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recipient"
        }
      },
      "required": [
        "issuer",
        "recipient"
      ],
      "title": "TransactionParty",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "rules_version": {
      "const": "stage5-domain-v1",
      "default": "stage5-domain-v1",
      "title": "Rules Version",
      "type": "string"
    },
    "currency_snapshot": {
      "additionalProperties": true,
      "title": "Currency Snapshot",
      "type": "object"
    },
    "input_sha256": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Input Sha256",
      "type": "string"
    },
    "context_sha256": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Context Sha256",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/NormalizedFile"
      },
      "title": "Files",
      "type": "array"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/NormalizedLine"
      },
      "title": "Lines",
      "type": "array"
    },
    "document_checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "title": "Document Checks",
      "type": "array"
    },
    "model_invocations": {
      "const": 0,
      "default": 0,
      "title": "Model Invocations",
      "type": "integer"
    },
    "billing_pipeline_executed": {
      "const": false,
      "default": false,
      "title": "Billing Pipeline Executed",
      "type": "boolean"
    }
  },
  "required": [
    "currency_snapshot",
    "input_sha256",
    "context_sha256",
    "files",
    "lines"
  ],
  "title": "NormalizationReport",
  "type": "object"
}

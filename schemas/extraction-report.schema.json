{
  "$defs": {
    "ChargeDetails": {
      "additionalProperties": false,
      "properties": {
        "charge_item": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Charge Item"
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "payment_term": {
          "anyOf": [
            {
              "enum": [
                "PP",
                "CC"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Payment Term"
        },
        "charge_item_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Charge Item Raw"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "unit_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price"
        },
        "payment_term_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payment Term Raw"
        },
        "currency_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency Raw"
        }
      },
      "required": [
        "charge_item",
        "amount",
        "currency",
        "payment_term"
      ],
      "title": "ChargeDetails",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Unit Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "DocumentInfo": {
      "additionalProperties": false,
      "properties": {
        "document_type": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Document Type"
        },
        "reference_no": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference No"
        },
        "document_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Document Date"
        },
        "document_date_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Date Raw"
        }
      },
      "required": [
        "document_type",
        "reference_no",
        "document_date"
      ],
      "title": "DocumentInfo",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "quote": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "locator",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceUnit": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Unit Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "method": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Method",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "unit_id",
        "source_id",
        "text",
        "locator",
        "method"
      ],
      "title": "EvidenceUnit",
      "type": "object"
    },
    "ExtractedCandidate": {
      "additionalProperties": false,
      "properties": {
        "source_line_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Line Id",
          "type": "string"
        },
        "document_info": {
          "$ref": "#/$defs/DocumentInfo"
        },
        "transaction_party": {
          "$ref": "#/$defs/TransactionParty"
        },
        "charge_details": {
          "$ref": "#/$defs/ChargeDetails"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "shipping_info": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Shipping Info",
          "type": "object"
        },
        "field_evidence": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Evidence"
            },
            "type": "array"
          },
          "title": "Field Evidence",
          "type": "object"
        }
      },
      "required": [
        "source_line_id",
        "document_info",
        "transaction_party",
        "charge_details",
        "evidence",
        "source_id"
      ],
      "title": "ExtractedCandidate",
      "type": "object"
    },
    "ExtractionFile": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "parent_source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Source Id"
        },
        "status": {
          "enum": [
            "extracted",
            "no_charge",
            "pending_review",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/ExtractedCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Observations",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "attempts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Attempts",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "status"
      ],
      "title": "ExtractionFile",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "blocks_automation": {
          "title": "Blocks Automation",
          "type": "boolean"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "blocks_automation",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "email_body",
            "email_header",
            "pdf_page",
            "image_region",
            "sheet_cells",
            "word_block",
            "existing_record"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "region": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "sheet": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "cells": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cells"
        },
        "block": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block"
        },
        "pointer": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointer"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Locator",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "total",
            "paid_amount",
            "general_term",
            "supporting_information"
          ],
          "title": "Kind",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "citations"
      ],
      "title": "Observation",
      "type": "object"
    },
    "TransactionParty": {
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Issuer"
        },
        "recipient": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recipient"
        }
      },
      "required": [
        "issuer",
        "recipient"
      ],
      "title": "TransactionParty",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "mode": {
      "enum": [
        "live",
        "replay",
        "test_injected"
      ],
      "title": "Mode",
      "type": "string"
    },
    "prompt_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Prompt Version",
      "type": "string"
    },
    "rules_version": {
      "const": "stage4-evidence-checks-v1",
      "default": "stage4-evidence-checks-v1",
      "title": "Rules Version",
      "type": "string"
    },
    "input_sha256": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Input Sha256",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ExtractionFile"
      },
      "title": "Files",
      "type": "array"
    },
    "evidence_units": {
      "items": {
        "$ref": "#/$defs/EvidenceUnit"
      },
      "title": "Evidence Units",
      "type": "array"
    },
    "model_invocations": {
      "default": 0,
      "title": "Model Invocations",
      "type": "integer"
    },
    "billing_pipeline_executed": {
      "const": false,
      "default": false,
      "title": "Billing Pipeline Executed",
      "type": "boolean"
    }
  },
  "required": [
    "mode",
    "prompt_version",
    "input_sha256"
  ],
  "title": "ExtractionReport",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

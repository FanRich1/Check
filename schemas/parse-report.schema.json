{
  "$defs": {
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "blocks_automation": {
          "title": "Blocks Automation",
          "type": "boolean"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "blocks_automation",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "email_body",
            "email_header",
            "pdf_page",
            "image_region",
            "sheet_cells",
            "word_block",
            "existing_record"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "region": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "sheet": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "cells": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cells"
        },
        "block": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block"
        },
        "pointer": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointer"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Locator",
      "type": "object"
    },
    "ParsedFragment": {
      "additionalProperties": false,
      "properties": {
        "fragment_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Fragment Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "method": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "fragment_id",
        "source_id",
        "text",
        "locator",
        "method"
      ],
      "title": "ParsedFragment",
      "type": "object"
    },
    "ParsedSource": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "parent_source_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Source Id"
        },
        "original_name": {
          "title": "Original Name",
          "type": "string"
        },
        "declared_mime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Mime"
        },
        "detected_format": {
          "default": "unknown",
          "title": "Detected Format",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Size Bytes"
        },
        "status": {
          "default": "parsed",
          "enum": [
            "parsed",
            "pending_review",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "fragments": {
          "items": {
            "$ref": "#/$defs/ParsedFragment"
          },
          "title": "Fragments",
          "type": "array"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/ParsedTable"
          },
          "title": "Tables",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "ocr_results": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Ocr Results",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "original_name",
        "sha256",
        "size_bytes"
      ],
      "title": "ParsedSource",
      "type": "object"
    },
    "ParsedTable": {
      "additionalProperties": false,
      "properties": {
        "table_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Table Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "rows": {
          "items": {
            "items": {},
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "table_id",
        "locator",
        "rows"
      ],
      "title": "ParsedTable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "mode": {
      "enum": [
        "offline",
        "live",
        "replay"
      ],
      "title": "Mode",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/ParsedSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "billing_pipeline_executed": {
      "const": false,
      "default": false,
      "title": "Billing Pipeline Executed",
      "type": "boolean"
    }
  },
  "required": [
    "mode"
  ],
  "title": "ParseReport",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

{
  "$defs": {
    "BillSnapshot": {
      "additionalProperties": true,
      "description": "Old snapshots preserve unknown root fields; do not reclassify historical operations.",
      "properties": {
        "record_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Id",
          "type": "string"
        },
        "document_info": {
          "$ref": "#/$defs/SnapshotDocumentInfo"
        },
        "transaction_party": {
          "$ref": "#/$defs/SnapshotTransactionParty"
        },
        "charge_details": {
          "$ref": "#/$defs/SnapshotChargeDetails"
        },
        "financial_attributes": {
          "$ref": "#/$defs/SnapshotFinancialAttributes"
        },
        "extensions": {
          "additionalProperties": true,
          "title": "Extensions",
          "type": "object"
        }
      },
      "required": [
        "record_id",
        "document_info",
        "transaction_party",
        "charge_details",
        "financial_attributes"
      ],
      "title": "BillSnapshot",
      "type": "object"
    },
    "SnapshotChargeDetails": {
      "additionalProperties": true,
      "properties": {
        "charge_item": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Charge Item"
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "payment_term": {
          "anyOf": [
            {
              "enum": [
                "PP",
                "CC"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Payment Term"
        },
        "charge_item_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Charge Item Raw"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "unit_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price"
        },
        "payment_term_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payment Term Raw"
        },
        "currency_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency Raw"
        }
      },
      "required": [
        "charge_item",
        "amount",
        "currency",
        "payment_term"
      ],
      "title": "SnapshotChargeDetails",
      "type": "object"
    },
    "SnapshotDocumentInfo": {
      "additionalProperties": true,
      "properties": {
        "document_type": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Document Type"
        },
        "reference_no": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference No"
        },
        "document_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Document Date"
        },
        "document_date_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Date Raw"
        }
      },
      "required": [
        "document_type",
        "reference_no",
        "document_date"
      ],
      "title": "SnapshotDocumentInfo",
      "type": "object"
    },
    "SnapshotFinancialAttributes": {
      "additionalProperties": true,
      "properties": {
        "accounting_entity": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accounting Entity"
        },
        "posting_type": {
          "anyOf": [
            {
              "enum": [
                "AR",
                "AP"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Posting Type"
        }
      },
      "required": [
        "accounting_entity",
        "posting_type"
      ],
      "title": "SnapshotFinancialAttributes",
      "type": "object"
    },
    "SnapshotTransactionParty": {
      "additionalProperties": true,
      "properties": {
        "issuer": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Issuer"
        },
        "recipient": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recipient"
        }
      },
      "required": [
        "issuer",
        "recipient"
      ],
      "title": "SnapshotTransactionParty",
      "type": "object"
    },
    "SourceDocument": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "url": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "role": {
          "default": "business_document",
          "enum": [
            "business_document",
            "supporting_document"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "SourceDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/SourceDocument"
      },
      "minItems": 1,
      "title": "Documents",
      "type": "array"
    },
    "accounting_entity": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Accounting Entity"
    },
    "existing_bills": {
      "items": {
        "$ref": "#/$defs/BillSnapshot"
      },
      "title": "Existing Bills",
      "type": "array"
    },
    "party_aliases": {
      "patternProperties": {
        "\\S": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Party Aliases",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "documents",
    "accounting_entity"
  ],
  "title": "BillingRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

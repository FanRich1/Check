{
  "$defs": {
    "FileResult": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "parent_source_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Source Id"
        },
        "status": {
          "enum": [
            "processed",
            "no_charge",
            "pending_review",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "status"
      ],
      "title": "FileResult",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "blocks_automation": {
          "title": "Blocks Automation",
          "type": "boolean"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "blocks_automation",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "mode": {
      "enum": [
        "offline",
        "online",
        "replay"
      ],
      "title": "Mode",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileResult"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "mode",
    "files"
  ],
  "title": "RunManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

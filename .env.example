# Offline commands do not require credentials. Online calls are explicit CLI commands.
BILLING_MODE=offline
BILLING_LOG_LEVEL=INFO
BILLING_OCR_ENDPOINT=http://36.103.199.11:5002/process
BILLING_OCR_CONNECT_TIMEOUT=10
BILLING_OCR_READ_TIMEOUT=300
# Set for model calls; config-check itself sends no requests.
# BILLING_MODEL_PROVIDER=
# BILLING_MODEL_NAME=
# BILLING_MODEL_BASE_URL=https://api.deepseek.com
# BILLING_MODEL_API_KEY=
# BILLING_MODEL_TIMEOUT=60
# BILLING_MODEL_MAX_TOKENS=4096
# Only pre-submission connect failures are retried. Read timeouts are not reposted.
BILLING_OCR_CONNECT_RETRIES=1
# parse --mode live requires an explicit OCR URL map or a --cloudflared executable.
